{
  "name": "protoplasma-ide",
  "productName": "Protoplasma",
  "version": "0.5.6",
  "description": "Multiplayer AI coding: everyone runs their own Claude Code or Codex, everyone sees every agent, with every / command intact.",
  "private": true,
  "main": "app/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "hub": "node src/hub.js",
    "test": "node --test --test-timeout=60000 test/*.test.js",
    "e2e": "electron scripts/e2e.js",
    "demo": "electron scripts/demo.js",
    "release": "[ \"$(git branch --show-current)\" = main ] || { echo 'Releases are made from main.'; exit 1; }; git fetch -q origin main && [ \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/main)\" ] || { echo 'Your main and GitHub main differ: pull or push first.'; exit 1; }; npm version patch && git push --follow-tags",
    "screenshot": "electron scripts/screenshot.js",
    "readme-art": "electron scripts/readme-art.js",
    "playground": "node scripts/playground.js",
    "dist": "electron-packager . Protoplasma --platform=darwin --arch=arm64 --out=dist --overwrite --icon=build/icon.icns --extend-info=build/extend-info.plist --asar.unpackDir=node_modules/node-pty --ignore=\"^/(dist|docs|scripts|test|build|\\.github|install\\.sh|CLAUDE\\.md|AGENTS\\.md|HANDOFF\\.md|node_modules/monaco-editor/(esm|dev))\"",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper",
    "icon": "electron scripts/icon.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bonjour-service": "^1.4.4",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "~44.10.0",
    "gifenc": "^1.0.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@44.10.0": true
  }
}
